import _root_.io.github.nafg.mergify.dsl.*

name := "slick-codegen-example"

inThisBuild(
  List(
    scalaVersion                        := "3.10.0",
    githubWorkflowPublishTargetBranches := Seq(),
    githubWorkflowBuild += WorkflowStep.Sbt(List("run")),
    githubWorkflowJavaVersions          := Seq(JavaSpec.temurin("17"))
  )
)

mergifyExtraConditions := Seq(
  (Attr.Author :== "scala-steward") ||
    (Attr.Author :== "slick-scala-steward[bot]") ||
    (Attr.Author :== "renovate[bot]")
)

scalacOptions ++= Seq(
  "-deprecation",
  // Tables.scala is generated by slick-codegen; its warnings can only be fixed in slick-codegen
  "-Wconf:src=src_managed/.*:s"
)
run / fork := true

val slickVersion = "4.0.0-RC2"

libraryDependencies ++= Seq(
  "com.typesafe.slick" %% "slick"         % slickVersion,
  "com.typesafe.slick" %% "slick-codegen" % slickVersion,
  "org.slf4j"           % "slf4j-nop"     % "2.0.20",
  "com.h2database"      % "h2"            % "2.5.252"
)

(Compile / sourceGenerators) += slick.taskValue // Automatic code generation on build

@transient
lazy val slick = taskKey[Seq[File]]("Generate Tables.scala")
slick := {
  val dir       = (Compile / sourceManaged).value
  val outputDir = dir / "slick"
  val url       =
    "jdbc:h2:mem:test;INIT=runscript from 'src/main/sql/create-schema.sql'" // connection info
  val jdbcDriver  = "org.h2.Driver"
  val slickDriver = "slick.jdbc.H2Profile"
  val pkg         = "demo"

  val cp = (Compile / dependencyClasspath).value
  val s  = streams.value
  given FileConverter = fileConverter.value
  sbt.IO.delete(outputDir)
  runner.value
    .run(
      "slick.codegen.SourceCodeGenerator",
      cp.files,
      Seq(
        slickDriver,
        jdbcDriver,
        url,
        outputDir.getPath,
        pkg,
        "sa",
        "",
        true.toString,
        "slick.codegen.SourceCodeGenerator",
        true.toString
      ),
      s.log
    )
    .failed
    .foreach(e => sys.error(e.getMessage))

  pkg
    .split("\\.")
    .foldLeft(outputDir) { (acc, d) =>
      acc / d
    }
    .listFiles
    .toSeq
    .filter(_.getName.endsWith(".scala"))

}
